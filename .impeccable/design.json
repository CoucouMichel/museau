  "narrative": {
    "northStar": "The Party Table Game",
    "overview": "Museau looks like something you would put in the middle of a table: a deck of big, readable cards on a soft lilac cloth, passed from hand to hand. The mood is clean and friendly, with one saturated pink doing the talking.",
    "keyCharacteristics": ["Pill-shaped controls and generous radii everywhere.", "One hot-pink action color on calm lilac or violet-black.", "Heavy, rounded Nunito for every word.", "Soft tinted shadows; buttons press down 2px.", "Each category owns a color that frames its cards."],
    "rules": [
      { "name": "The One Hot Color Rule", "body": "Snout Pink is the only action color; category colors frame content and never become buttons.", "section": "colors" },
      { "name": "The Heavy Round Rule", "body": "Never use a weight below 500; headings are 900.", "section": "typography" },
      { "name": "The Press Down Rule", "body": "Interactive elements respond to touch by moving down 2px and shrinking their shadow; they never lift on hover.", "section": "elevation" }
    ],
    "dos": ["Do use Snout Pink for the one main action per screen.", "Do keep every control a pill or circle with at least 38px height.", "Do write all UI copy in French, and keep the \"groin\" vocabulary.", "Do frame cards with their category color and keep the word at 32px or larger.", "Do provide the dark theme via the [data-theme=\"dark\"] variable overrides."],
    "donts": ["Don't add hard offset shadows, gradients-as-decoration or neon glows.", "Don't use category colors for buttons or toggles.", "Don't use sharp corners or a second typeface.", "Don't crowd screens; one action and a few controls at a time."]
