{
  "name": "museau",
  "private": true,
  "version": "1.0.0",
  "description": "Museau — groin ou pas groin ? Jeu d'ambiance de culture générale à swiper.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
